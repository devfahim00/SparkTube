<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors item_video.xml: 16:9 thumbnail + circular avatar + 2-line
     title + one meta line. Used by the skeleton loader while a feed is
     being fetched, so the shimmer doesn't jump when real content lands. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/skelThumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_skeleton_thumb"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/skelAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_skeleton_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skelThumb" />

    <View
        android:id="@+id/skelTitle"
        android:layout_width="0dp"
        android:layout_height="15dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="60dp"
        android:background="@drawable/bg_skeleton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/skelAvatar"
        app:layout_constraintTop_toBottomOf="@id/skelThumb" />

    <View
        android:id="@+id/skelMeta"
        android:layout_width="0dp"
        android:layout_height="11dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="120dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_skeleton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/skelAvatar"
        app:layout_constraintTop_toBottomOf="@id/skelTitle" />
</androidx.constraintlayout.widget.ConstraintLayout>
